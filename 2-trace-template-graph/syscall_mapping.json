{
  "_schema": {
    "_comment": "Pi: the operation map (paper Sec 4.1, App A.1). Each normalized API identifier maps to an ordered list of operation records. A record's 'kind' selects how the extractor lowers it; 'arg' is the argument index carrying the operand (the selector), 'class' the event class in Sigma_sigma. This is a measured/authored table, keyed on (OS, host collector, runtime, library version); it never names a CVE. Kinds: http (target-view request under R*), spawn (process creation), file (host file I/O, mode-derived read/write), net (socket exchange), generic (object op via the type map).",
    "_kinds": {
      "http": "arg is the URL/path; class is read (GET/HEAD) or write (POST/PUT/DELETE/PATCH) as the collector records it",
      "spawn": "arg is the command/executable; emits a child process vertex under the acting subject",
      "file": "arg is the path; mode_arg (if present) picks read vs write, else 'class'",
      "net": "arg is the destination; class is send/receive/connect",
      "generic": "arg is the operand; 'syscall' names the type-map entry giving object type and direction"
    }
  },

